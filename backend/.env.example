PORT=4000
# Required in production — use: openssl rand -base64 48
JWT_SECRET=
# Comma-separated frontend URLs (production example below)
CORS_ORIGINS=https://frontend-xi-three-35.vercel.app
# Emails allowed to create new pharmacy accounts
PLATFORM_ADMIN_EMAILS=admin@jantra.local
DB_MIGRATIONS_RUN=true

# Neon (Vercel Postgres) — use pooled connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Local fallback (when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pharmacy_db

# Dev-only seed (change immediately in production)
ADMIN_EMAIL=admin@jantra.local
ADMIN_PASSWORD=set-a-strong-password-for-dev-seed-only
